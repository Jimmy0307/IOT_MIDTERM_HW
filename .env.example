# Copy to .env for local labs. DEMO / LOCAL ONLY values - never production creds.

# --- PostgreSQL (E3) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iotlab

# Admin DSN (schema owner, seeding / DB-state verification only)
E3_ADMIN_DSN=postgresql://postgres:postgres@127.0.0.1:55432/iotlab
# Restricted runtime role used by the search API (least privilege)
E3_READER_DSN=postgresql://iot_search_reader:DEMO_LOCAL_ONLY_reader_pw@127.0.0.1:55432/iotlab

# --- E2 per-device secrets (optional overrides; defaults are DEMO/LOCAL) ---
# E2_SECRET_DISPENSER_01=DEMO_LOCAL_ONLY_device_secret_dispenser_01
